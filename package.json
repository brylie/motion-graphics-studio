{
	"name": "isf-test",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"format": "prettier --write .github/workflows .storybook e2e src package.json svelte.config.js vite.config.ts playwright.config.ts eslint.config.js .prettierrc.json",
		"format:check": "prettier --check .github/workflows .storybook e2e src package.json svelte.config.js vite.config.ts playwright.config.ts eslint.config.js .prettierrc.json",
		"test:unit": "vitest --project unit --project component",
		"test:storybook": "vitest --project storybook --run",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^5.2.1",
		"@eslint/js": "^9.39.5",
		"@playwright/test": "^1.62.1",
		"@storybook/addon-a11y": "^10.5.5",
		"@storybook/addon-docs": "^10.5.5",
		"@storybook/addon-svelte-csf": "^5.1.2",
		"@storybook/addon-vitest": "^10.5.5",
		"@storybook/sveltekit": "^10.5.5",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^26.1.2",
		"@vitest/browser-playwright": "^4.1.10",
		"@vitest/coverage-v8": "^4.1.10",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.9.0",
		"playwright": "^1.62.1",
		"prettier": "^3.9.6",
		"storybook": "^10.5.5",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.65.0",
		"vite": "^8.2.0",
		"vite-plugin-devtools-json": "^1.1.0",
		"vitest": "^4.1.10",
		"vitest-browser-svelte": "^3.0.0"
	},
	"dependencies": {
		"tone": "^15.1.22",
		"uuid": "^14.0.1"
	}
}
